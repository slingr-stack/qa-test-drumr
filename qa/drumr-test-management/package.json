{
  "name": "@drumr/test-management",
  "version": "1.0.0-beta.3",
  "description": "Drumr Test Manager extension and CLI presets. Parses, manages, and executes test suites (Unit, Integration, E2E) across a Drumr application workspace.",
  "main": "./dist/cli/commands/tests/open.js",
  "types": "./dist/cli/commands/tests/open.d.ts",
  "bin": {
    "drumr-test-manager": "./dist/cli/bin/test-manager.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/commands/tests/open.d.ts",
      "require": "./dist/cli/commands/tests/open.js",
      "default": "./dist/cli/commands/tests/open.js"
    },
    "./open": {
      "types": "./dist/cli/commands/tests/open.d.ts",
      "require": "./dist/cli/commands/tests/open.js",
      "default": "./dist/cli/commands/tests/open.js"
    },
    "./setup": {
      "types": "./dist/cli/commands/tests/setup.d.ts",
      "require": "./dist/cli/commands/tests/setup.js",
      "default": "./dist/cli/commands/tests/setup.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && pnpm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "publish:gcp": "node scripts/publish.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.14.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://us-central1-npm.pkg.dev/slingr-qa/drumr-npm/",
    "access": "restricted"
  }
}